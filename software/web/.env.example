# Copy to .env and change as needed. Never commit .env.

# Backend URL. Leave it commented out to go through the Vite proxy at /api
# (see vite.config.js), which keeps the login cookie working in dev.
# VITE_API_URL=http://localhost:8000

# Where dashboard readings come from:
#   sample -> sample CSVs only, never calls the backend for readings
#   hybrid -> CSV history + live sensor readings (default)
#   sensor -> live sensor readings only
VITE_DATA_MODE=hybrid
